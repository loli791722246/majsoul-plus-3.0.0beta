{
  "name": "majsoul-plus",
  "version": "3.0.0",
  "productName": "Majsoul Plus",
  "author": "Majsoul Plus Team",
  "description": "Majsoul Plus (MITM edition)",
  "main": "./dist/index.js",
  "scripts": {
    "sass": "sass --no-source-map assets/manager:assets/manager",
    "pre-build": "tsc && sass --no-source-map assets/manager:assets/manager && node build.js",
    "debug": "cross-env NODE_ENV=development run-electron .",
    "debug:server": "cross-env NODE_ENV=development SERVER_ONLY=1 run-electron .",
    "debug:detailed": "cross-env NODE_ENV=development run-electron . --enable-logging --v=1 --disable-gpu",
    "start": "npm run pre-build && npm run debug",
    "start:detailed": "npm run pre-build && npm run debug:detailed",
    "test": "node test/mitm-smoke.js",
    "dist": "npm run pre-build && electron-builder --x64 --publish never",
    "build": "npm run pre-build && electron-builder --x64 --publish never",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "productName": "Majsoul Plus",
    "artifactName": "majsoul-plus-${version}-${platform}-${arch}.${ext}",
    "directories": {
      "output": "build/"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/patcher-bin/patcher",
        "to": "patcher"
      }
    ],
    "fileAssociations": {
      "ext": [
        "mspr",
        "mspe",
        "mspm",
        "mspt"
      ],
      "description": "Majsoul Plus ResourcePack/Extension/Tool",
      "icon": "assets/bin/icons/icon.ico"
    },
    "afterAllArtifactBuild": "afterAllArtifactBuild.js",
    "win": {
      "icon": "assets/bin/icons/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "majsoul-plus-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "雀魂 Plus"
    },
    "mac": {
      "icon": "assets/bin/icons/icon.icns",
      "darkModeSupport": true,
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "assets/bin/icons/icon.png",
      "category": "Game",
      "target": [
        "tar.gz"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamapig120/majsoul-custorm-server.git"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ajv": "^6.12.6",
    "chalk": "^2.4.2",
    "comma-separated-values": "^3.6.4",
    "js-yaml": "^4.1.0",
    "koa": "^2.15.3",
    "koa-router": "^7.4.0",
    "node-forge": "^1.3.1",
    "prettier": "^1.19.1",
    "protobufjs": "^7.4.0",
    "semver": "^6.3.1",
    "tcp-ping": "^0.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa-router": "^7.4.8",
    "@types/node": "^20.16.0",
    "@types/node-forge": "^1.3.11",
    "@types/semver": "^7.5.8",
    "@types/tcp-ping": "^0.1.4",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "run-electron": "^1.0.0",
    "sass": "^1.80.6",
    "typescript": "^5.6.3"
  }
}
